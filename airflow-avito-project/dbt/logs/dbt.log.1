        source_url
    from "avito_dwh"."raw"."avito_ads_csv"
    where csv_header = 'avito_id,title,price_rub,url,location,seller,parsed_at'
)

select
    avito_id,
    title,
    price_rub,
    url,
    location,
    seller,
    parsed_at,
    source_url,
    case
        when source_url like 'synthetic://%' then 'synthetic_avito'
        else 'avito'
    end as source_system
from parsed
  );
  
