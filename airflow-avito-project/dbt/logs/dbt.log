  (
    

with parsed as (
    select
        nullif(split_part(csv_row, ',', 1), '')::bigint as avito_id,
        nullif(split_part(csv_row, ',', 2), '') as title,
        nullif(split_part(csv_row, ',', 3), '')::numeric(12, 2) as price_rub,
