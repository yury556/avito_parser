AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

POSTGRES_DB=avito_dwh
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito123
POSTGRES_HOST=external-postgres
POSTGRES_PORT=5432

AVITO_SEARCH_URLS=https://www.avito.ru/moskva?q=iphone
AVITO_MAX_PAGES=1
AVITO_REQUEST_TIMEOUT=20
AVITO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/126 Safari/537.36

# Прокси (если нужно)
AVITO_PROXY_STRING=
AVITO_PROXY_CHANGE_URL=

# Cookies: внешний API или свои
AVITO_COOKIES_API_KEY=
AVITO_USE_BYPASS_API=false
AVITO_USE_OWN_COOKIES=false

# Фильтры
AVITO_MIN_PRICE=0
AVITO_MAX_PRICE=999999999
AVITO_WHITE_LIST=
AVITO_BLACK_LIST=
AVITO_SELLER_BLACK_LIST=
AVITO_MAX_AGE=86400
AVITO_IGNORE_RESERV=true
AVITO_IGNORE_PROMOTION=false
AVITO_PARSE_VIEWS=false

# Retry / блокировки
AVITO_RETRY_DELAY=5
AVITO_BLOCK_THRESHOLD=3
AVITO_PAUSE_BETWEEN_LINKS=5

# Apache Superset. The metadata database has no host port; only the UI is exposed.
SUPERSET_HOST_PORT=18088
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
SUPERSET_META_DB_NAME=superset
SUPERSET_META_DB_USER=superset
SUPERSET_META_DB_PASSWORD=superset
SUPERSET_ADMIN_USERNAME=superset
SUPERSET_ADMIN_PASSWORD=superset
SUPERSET_ADMIN_FIRSTNAME=Superset
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=superset@example.com

